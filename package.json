{
  "name": "qwen-reverse-prompt",
  "version": "1.0.0",
  "private": true,
  "description": "视频反推提示词 - 基于 chat.qwen.ai 网页中继",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.yingce.reverseprompt",
    "productName": "VideoReversePrompt",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*"
    ],
    "asarUnpack": [
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": ["**/*"]
      },
      {
        "from": "browsers",
        "to": "browsers",
        "filter": [
          "**/*",
          "!chromium_headless_shell-*/**",
          "!ffmpeg-*/**",
          "!winldd-*/**"
        ]
      }
    ],
    "win": {
      "target": ["dir"]
    }
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.47.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
